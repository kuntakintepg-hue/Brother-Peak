// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © Brother Peak — WickPulse Indicator
// An original wick-behavior framework for futures trading.
// No recycled concepts. Built from scratch around what wicks actually reveal.

//@version=5
indicator("WickPulse — Wick Behavior Engine", shorttitle="WickPulse", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================================================================
// INPUTS
// ============================================================================

// --- Core Settings ---
grpCore = "Core Settings"
wickLookback      = input.int(20, "Wick Analysis Lookback", minval=5, maxval=100, group=grpCore, tooltip="How many bars to analyze for wick patterns")
sensitivity       = input.string("Medium", "Sensitivity", options=["Low", "Medium", "High"], group=grpCore, tooltip="Low = fewer signals (higher quality), High = more signals")
showDashboard     = input.bool(true, "Show Dashboard", group=grpCore)

// --- Phantom Levels ---
grpPhantom = "Phantom Levels"
showPhantomLevels = input.bool(true, "Show Phantom Levels", group=grpPhantom)
phantomLookback   = input.int(20, "Phantom Lookback", minval=10, maxval=50, group=grpPhantom, tooltip="How far back to scan for wick clusters")
phantomStrength   = input.int(3, "Min Wick Touches", minval=2, maxval=10, group=grpPhantom, tooltip="Minimum wick tips needed to form a Phantom Level")
phantomZoneWidth  = input.float(0.3, "Zone Width (ATR %)", minval=0.05, maxval=1.0, step=0.05, group=grpPhantom, tooltip="Width of Phantom zones as % of ATR")

// --- Trap Detection ---
grpTrap = "Trap Detection"
showTraps         = input.bool(true, "Show Trap Signals", group=grpTrap)
trapWickMinRatio  = input.float(1.5, "Trap Wick Min Ratio", minval=1.0, maxval=5.0, step=0.1, group=grpTrap, tooltip="How long the trapping wick must be relative to body")

// --- Exhaustion ---
grpExhaust = "Exhaustion Signatures"
showExhaustion    = input.bool(true, "Show Exhaustion Signals", group=grpExhaust)
exhaustLookback   = input.int(5, "Exhaustion Lookback", minval=3, maxval=15, group=grpExhaust, tooltip="How many bars to check for diminishing wick pattern")

// --- Wick Tension ---
grpTension = "Wick Tension Zones"
showTension       = input.bool(true, "Show Tension Zones", group=grpTension)
tensionLookback   = input.int(8, "Tension Lookback", minval=4, maxval=20, group=grpTension, tooltip="Bars to analyze for wick compression")
tensionThreshold  = input.float(0.4, "Compression Threshold", minval=0.1, maxval=0.8, step=0.05, group=grpTension, tooltip="How compressed wicks must be to flag tension (lower = tighter)")

// --- Divergence ---
grpDiv = "Wick Divergence"
showDivergence    = input.bool(true, "Show Wick Divergence", group=grpDiv)
divLookback       = input.int(10, "Divergence Lookback", minval=5, maxval=30, group=grpDiv)

// --- Signals ---
grpSignal = "Signal Settings"
minConfluence     = input.int(2, "Min Confluence Score", minval=1, maxval=6, group=grpSignal, tooltip="Minimum stacked signals needed to fire an alert (2 = balanced, 3+ = sniper)")
showAllSignals    = input.bool(true, "Show Individual Sub-Signals", group=grpSignal, tooltip="Show each component signal, not just confluent ones")

// --- Visuals ---
grpVis = "Visual Style"
bullColor         = input.color(color.new(#00E676, 0), "Bull Color", group=grpVis)
bearColor         = input.color(color.new(#FF1744, 0), "Bear Color", group=grpVis)
phantomBullColor  = input.color(color.new(#00E676, 75), "Phantom Level Bull", group=grpVis)
phantomBearColor  = input.color(color.new(#FF1744, 75), "Phantom Level Bear", group=grpVis)
tensionColor      = input.color(color.new(#FFC107, 70), "Tension Zone Color", group=grpVis)

// ============================================================================
// SENSITIVITY MULTIPLIERS
// ============================================================================

float sensMultiplier = switch sensitivity
    "Low"    => 1.4
    "Medium" => 1.0
    "High"   => 0.7

// ============================================================================
// FOUNDATIONAL CALCULATIONS
// ============================================================================

// --- ATR for adaptive thresholds ---
atrLen     = 14
atrVal     = ta.atr(atrLen)
float atrPct = atrVal / close * 100

// --- Candle Anatomy ---
float bodySize   = math.abs(close - open)
float upperWick  = high - math.max(close, open)
float lowerWick  = math.min(close, open) - low
float totalRange = high - low
bool  isBull     = close > open
bool  isBear     = close < open
bool  isDoji     = bodySize < totalRange * 0.1

// --- Wick Ratios (the foundation of everything) ---
float bodyGuard     = math.max(bodySize, atrVal * 0.01)  // prevent division by zero
float upperWickRatio = upperWick / bodyGuard
float lowerWickRatio = lowerWick / bodyGuard
float wickAsymmetry  = (upperWick - lowerWick) / math.max(totalRange, atrVal * 0.01)
// +1 = all upper wick (bearish rejection), -1 = all lower wick (bullish rejection)

// --- Relative Volume (handle instruments with no volume data) ---
// ta.sma MUST be called every bar (not inside ternary) or Pine corrupts its state
bool hasVolume   = not na(volume) and volume > 0
float volSma     = ta.sma(volume, wickLookback)
float avgVol     = hasVolume ? volSma : 1.0
float relVol     = hasVolume ? volume / math.max(avgVol, 1) : 1.0

// ============================================================================
// 1. WICK DNA — Classify each candle's wick fingerprint
// ============================================================================
// Every candle has a "DNA" — we classify it by what its wicks reveal about
// the fight between buyers and sellers.

// Wick Dominance: who won the bar?
// Positive = buyers dominated (long lower wicks = bought the dip)
// Negative = sellers dominated (long upper wicks = sold the rip)
float wickDominance = (lowerWick - upperWick) / math.max(totalRange, atrVal * 0.01)

// Wick Aggression: how violent was the rejection?
float wickAggression = math.max(upperWick, lowerWick) / math.max(totalRange, atrVal * 0.01)

// Wick DNA Classification
string wickDNA = "Neutral"
if wickAggression > 0.45 and wickDominance > 0.2
    wickDNA := "BullReject"    // Strong lower wick = aggressive buying
else if wickAggression > 0.45 and wickDominance < -0.2
    wickDNA := "BearReject"    // Strong upper wick = aggressive selling
else if wickAggression > 0.45 and math.abs(wickDominance) <= 0.2
    wickDNA := "Contested"     // Both wicks big = war zone
else if wickAggression < 0.2
    wickDNA := "Conviction"    // Tiny wicks = one side fully in control
else
    wickDNA := "Neutral"

// ============================================================================
// 2. WICK PRESSURE INDEX (WPI) — Directional force through wick behavior
// ============================================================================
// Are wicks consistently rejecting one direction? That's pressure building.
// This is NOT a moving average — it reads wick intention over time.

float wickPressureRaw = 0.0
for i = 0 to wickLookback - 1
    float lw = math.min(close[i], open[i]) - low[i]
    float uw = high[i] - math.max(close[i], open[i])
    float tr = high[i] - low[i]
    float guard = math.max(tr, atrVal * 0.01)
    wickPressureRaw += (lw - uw) / guard

float wickPressureIndex = wickPressureRaw / wickLookback
// WPI > 0 = bullish pressure (lower wicks dominating = buyers stepping in)
// WPI < 0 = bearish pressure (upper wicks dominating = sellers capping)

// Pressure is "strong" when it exceeds threshold
float pressureThresh = 0.18 * sensMultiplier
bool strongBullPressure = wickPressureIndex > pressureThresh
bool strongBearPressure = wickPressureIndex < -pressureThresh

// ============================================================================
// 3. PHANTOM LEVELS — Invisible S/R from wick cluster analysis
// ============================================================================
// Price bodies lie. Wicks don't. Where wick tips cluster = where real
// orders sit. These are the levels nobody draws but everybody reacts to.

// Rolling wick-tip tracker: collect wick tips bar-by-bar (no nested loops)
var float[] wickLows  = array.new_float(0)  // lower wick tip history
var float[] wickHighs = array.new_float(0)  // upper wick tip history

// Only track wicks with meaningful size
float curLowerWick = math.min(close, open) - low
float curUpperWick = high - math.max(close, open)

if curLowerWick > atrVal * 0.1
    array.push(wickLows, low)
    if array.size(wickLows) > phantomLookback
        array.shift(wickLows)

if curUpperWick > atrVal * 0.1
    array.push(wickHighs, high)
    if array.size(wickHighs) > phantomLookback
        array.shift(wickHighs)

// Find phantom levels only on last bar (single pass, no O(n²))
var float[] phantomBullLevels = array.new_float(0)
var float[] phantomBearLevels = array.new_float(0)

bool nearPhantomBull = false
bool nearPhantomBear = false

if showPhantomLevels and barstate.islast
    array.clear(phantomBullLevels)
    array.clear(phantomBearLevels)
    float zoneW = atrVal * phantomZoneWidth

    // Sort and cluster lower wick tips (support)
    if array.size(wickLows) >= phantomStrength
        float[] sortedLows = array.copy(wickLows)
        array.sort(sortedLows, order.ascending)
        int cluster = 1
        float clusterSum = array.get(sortedLows, 0)
        for i = 1 to array.size(sortedLows) - 1
            if array.get(sortedLows, i) - array.get(sortedLows, i - 1) <= zoneW
                cluster += 1
                clusterSum += array.get(sortedLows, i)
            else
                if cluster >= phantomStrength
                    array.push(phantomBullLevels, clusterSum / cluster)
                cluster := 1
                clusterSum := array.get(sortedLows, i)
        if cluster >= phantomStrength
            array.push(phantomBullLevels, clusterSum / cluster)

    // Sort and cluster upper wick tips (resistance)
    if array.size(wickHighs) >= phantomStrength
        float[] sortedHighs = array.copy(wickHighs)
        array.sort(sortedHighs, order.ascending)
        int cluster = 1
        float clusterSum = array.get(sortedHighs, 0)
        for i = 1 to array.size(sortedHighs) - 1
            if array.get(sortedHighs, i) - array.get(sortedHighs, i - 1) <= zoneW
                cluster += 1
                clusterSum += array.get(sortedHighs, i)
            else
                if cluster >= phantomStrength
                    array.push(phantomBearLevels, clusterSum / cluster)
                cluster := 1
                clusterSum := array.get(sortedHighs, i)
        if cluster >= phantomStrength
            array.push(phantomBearLevels, clusterSum / cluster)

// Draw Phantom Levels
var box[] phantomBoxes = array.new_box(0)

if barstate.islast
    // Clean old boxes
    for i = array.size(phantomBoxes) - 1 to 0
        box.delete(array.get(phantomBoxes, i))
    array.clear(phantomBoxes)

    if showPhantomLevels
        float zoneW = atrVal * phantomZoneWidth
        for i = 0 to array.size(phantomBullLevels) - 1
            float lvl = array.get(phantomBullLevels, i)
            if math.abs(close - lvl) < atrVal * 8
                array.push(phantomBoxes, box.new(bar_index - phantomLookback, lvl + zoneW / 2, bar_index + 10, lvl - zoneW / 2, border_color=color.new(bullColor, 60), bgcolor=phantomBullColor, border_width=1, border_style=line.style_dotted))
        for i = 0 to array.size(phantomBearLevels) - 1
            float lvl = array.get(phantomBearLevels, i)
            if math.abs(close - lvl) < atrVal * 8
                array.push(phantomBoxes, box.new(bar_index - phantomLookback, lvl + zoneW / 2, bar_index + 10, lvl - zoneW / 2, border_color=color.new(bearColor, 60), bgcolor=phantomBearColor, border_width=1, border_style=line.style_dotted))

// Is price near a phantom level right now?
if array.size(phantomBullLevels) > 0
    for i = 0 to array.size(phantomBullLevels) - 1
        float dist = math.abs(low - array.get(phantomBullLevels, i))
        if dist < atrVal * 1.5
            nearPhantomBull := true

if array.size(phantomBearLevels) > 0
    for i = 0 to array.size(phantomBearLevels) - 1
        float dist = math.abs(high - array.get(phantomBearLevels, i))
        if dist < atrVal * 1.5
            nearPhantomBear := true

// ============================================================================
// 4. TRAP DETECTION — Who just got caught?
// ============================================================================
// A trap happens when price extends past a level (grabbing liquidity),
// then violently snaps back. The wick IS the trap.
// We measure: extension length, snap-back speed, and volume on the trap bar.

// Bull Trap: price spikes UP (long upper wick) then closes weak
// Bear Trap: price spikes DOWN (long lower wick) then closes strong

float trapThresh = trapWickMinRatio * sensMultiplier

// Pre-compute outside conditional to avoid Pine warnings
float recentLow  = ta.lowest(low, 3)[1]
float recentHigh = ta.highest(high, 3)[1]

// Bear trap (bullish): long lower wick, closes in upper portion
bool bearTrap = lowerWickRatio > trapThresh and
     lowerWick > upperWick * 1.3 and
     (isBull or isDoji) and
     (low <= recentLow or lowerWick > atrVal * 0.5)  // swept recent lows OR big wick

// Bull trap (bearish): long upper wick, closes in lower portion
bool bullTrap = upperWickRatio > trapThresh and
     upperWick > lowerWick * 1.3 and
     (isBear or isDoji) and
     (high >= recentHigh or upperWick > atrVal * 0.5)  // swept recent highs OR big wick

// Trap intensity (0-100)
float trapIntensity = 0.0
if bearTrap
    trapIntensity := math.min(100, (lowerWickRatio / trapThresh) * 40 + relVol * 20 + (lowerWick / totalRange) * 40)
if bullTrap
    trapIntensity := math.min(100, (upperWickRatio / trapThresh) * 40 + relVol * 20 + (upperWick / totalRange) * 40)

// ============================================================================
// 5. EXHAUSTION SIGNATURES — The fuel is running out
// ============================================================================
// When a trend is running, wicks tell you when it's about to die.
// In an uptrend: if upper wicks get progressively shorter = buyers still
// strong. If lower wicks start growing = sellers creeping in.
// Exhaustion = diminishing trend-side wicks + growing counter-side wicks.

bool bullExhaustion = false  // uptrend running out of steam
bool bearExhaustion = false  // downtrend running out of steam

// ta.sma must be called every bar, not inside conditional scope
float closeSma = ta.sma(close, wickLookback)

if showExhaustion
    // Check for uptrend exhaustion
    bool inUptrend = close > closeSma
    if inUptrend
        // Count diminishing bodies + growing upper wicks over N bars
        int dimBodyCount = 0
        int growUpperCount = 0
        for i = 0 to exhaustLookback - 2
            float bodyI    = math.abs(close[i] - open[i])
            float bodyI1   = math.abs(close[i+1] - open[i+1])
            float uwI      = high[i] - math.max(close[i], open[i])
            float uwI1     = high[i+1] - math.max(close[i+1], open[i+1])
            if bodyI < bodyI1
                dimBodyCount += 1
            if uwI > uwI1
                growUpperCount += 1
        bullExhaustion := dimBodyCount >= 2 and growUpperCount >= 2

    // Check for downtrend exhaustion
    bool inDowntrend = close < closeSma
    if inDowntrend
        int dimBodyCount = 0
        int growLowerCount = 0
        for i = 0 to exhaustLookback - 2
            float bodyI    = math.abs(close[i] - open[i])
            float bodyI1   = math.abs(close[i+1] - open[i+1])
            float lwI      = math.min(close[i], open[i]) - low[i]
            float lwI1     = math.min(close[i+1], open[i+1]) - low[i+1]
            if bodyI < bodyI1
                dimBodyCount += 1
            if lwI > lwI1
                growLowerCount += 1
        bearExhaustion := dimBodyCount >= 2 and growLowerCount >= 2

// ============================================================================
// 6. WICK TENSION ZONES — Coiling energy about to explode
// ============================================================================
// When both upper and lower wicks shrink simultaneously over N bars,
// that's compression. The market is coiling. Breakout imminent.
// Like a spring being pressed — the tighter it gets, the harder it snaps.

float avgWickSize   = ta.sma(upperWick + lowerWick, tensionLookback)
float currentWickSize = upperWick + lowerWick
float wickCompression = currentWickSize / math.max(avgWickSize, atrVal * 0.01)

// Check if wicks have been shrinking (allow 1 exception)
int wickGrowCount = 0
for i = 0 to math.min(tensionLookback - 2, 5)
    float totalWickI  = (high[i] - math.max(close[i], open[i])) + (math.min(close[i], open[i]) - low[i])
    float totalWickI1 = (high[i+1] - math.max(close[i+1], open[i+1])) + (math.min(close[i+1], open[i+1]) - low[i+1])
    if totalWickI > totalWickI1 * 1.15
        wickGrowCount += 1
bool wicksShrinking = wickGrowCount <= 1

bool tensionBuilding = wicksShrinking and wickCompression < tensionThreshold * sensMultiplier
float tensionScore   = tensionBuilding ? (1.0 - wickCompression) * 100 : 0.0

// Pre-compute outside conditional scope to avoid Pine warnings
float tensionHigh = ta.highest(high, tensionLookback)
float tensionLow  = ta.lowest(low, tensionLookback)

// Draw tension zones
var box tensionBox = na
if showTension and tensionBuilding
    if not na(tensionBox)
        box.delete(tensionBox)
    tensionBox := box.new(bar_index - tensionLookback, tensionHigh, bar_index, tensionLow, border_color=tensionColor, bgcolor=tensionColor, border_width=1, border_style=line.style_dashed)
else if not tensionBuilding and not na(tensionBox)
    box.delete(tensionBox)
    tensionBox := na

// ============================================================================
// 7. WICK DIVERGENCE — Body lies, wicks tell the truth
// ============================================================================
// Price body moves up but wicks are increasingly rejecting from above?
// That's wick divergence — the body says bull, the wicks say bear.

bool bullWickDiv = false  // body bearish but wicks say bullish
bool bearWickDiv = false  // body bullish but wicks say bearish

if showDivergence
    // Price direction over lookback
    float priceChange  = close - close[divLookback]

    // Wick direction over lookback (sum of dominance)
    float wickDirSum = 0.0
    for i = 0 to divLookback - 1
        float lwI = math.min(close[i], open[i]) - low[i]
        float uwI = high[i] - math.max(close[i], open[i])
        float trI = high[i] - low[i]
        wickDirSum += (lwI - uwI) / math.max(trI, atrVal * 0.01)
    float wickDir = wickDirSum / divLookback

    // Divergence: price and wicks disagree
    float divThresh = 0.15 / sensMultiplier
    bullWickDiv := priceChange < -atrVal * 0.3 and wickDir > divThresh   // price falling, wicks bullish
    bearWickDiv := priceChange > atrVal * 0.3 and wickDir < -divThresh   // price rising, wicks bearish

// ============================================================================
// 8. CONFLUENCE SCORING — Stack them up
// ============================================================================
// Each signal alone is a hint. Stacked together = conviction.
// We score from 0 to 6 for each direction.

int bullScore = 0
int bearScore = 0

// Wick Pressure
if strongBullPressure
    bullScore += 1
if strongBearPressure
    bearScore += 1

// Trap Detection
if bearTrap
    bullScore += 2  // bear trap = bullish (trapped sellers)
if bullTrap
    bearScore += 2  // bull trap = bearish (trapped buyers)

// Phantom Level proximity
if nearPhantomBull
    bullScore += 1
if nearPhantomBear
    bearScore += 1

// Exhaustion
if bullExhaustion
    bearScore += 1  // uptrend exhaustion = bearish
if bearExhaustion
    bullScore += 1  // downtrend exhaustion = bullish

// Wick Divergence
if bullWickDiv
    bullScore += 1
if bearWickDiv
    bearScore += 1

// Wick DNA confirmation
if wickDNA == "BullReject"
    bullScore += 1
if wickDNA == "BearReject"
    bearScore += 1

// ============================================================================
// 9. SIGNAL GENERATION
// ============================================================================

bool bullSignal = bullScore >= minConfluence and bullScore > bearScore
bool bearSignal = bearScore >= minConfluence and bearScore > bullScore

// Prevent consecutive same signals (minimum 2 bars apart)
var int lastBullBar = 0
var int lastBearBar = 0

if bullSignal and bar_index - lastBullBar < 2
    bullSignal := false
if bearSignal and bar_index - lastBearBar < 2
    bearSignal := false

if bullSignal
    lastBullBar := bar_index
if bearSignal
    lastBearBar := bar_index

// ============================================================================
// 10. VISUAL OUTPUT
// ============================================================================

// --- Main Signals ---
string bullTip = "WickPulse LONG\nConfluence: " + str.tostring(bullScore) + "/6"
string bearTip = "WickPulse SHORT\nConfluence: " + str.tostring(bearScore) + "/6"

// Add details to tooltip
if bullSignal
    if bearTrap
        bullTip += "\n• Bear Trap (intensity: " + str.tostring(trapIntensity, "#") + ")"
    if strongBullPressure
        bullTip += "\n• Wick Pressure: Bullish"
    if nearPhantomBull
        bullTip += "\n• Near Phantom Support"
    if bearExhaustion
        bullTip += "\n• Downtrend Exhaustion"
    if bullWickDiv
        bullTip += "\n• Wick Divergence (Bullish)"
    if wickDNA == "BullReject"
        bullTip += "\n• Wick DNA: Bull Rejection"

if bearSignal
    if bullTrap
        bearTip += "\n• Bull Trap (intensity: " + str.tostring(trapIntensity, "#") + ")"
    if strongBearPressure
        bearTip += "\n• Wick Pressure: Bearish"
    if nearPhantomBear
        bearTip += "\n• Near Phantom Resistance"
    if bullExhaustion
        bearTip += "\n• Uptrend Exhaustion"
    if bearWickDiv
        bearTip += "\n• Wick Divergence (Bearish)"
    if wickDNA == "BearReject"
        bearTip += "\n• Wick DNA: Bear Rejection"

// Signal markers (labels support tooltips for detailed breakdown)
if bullSignal
    label.new(bar_index, low, "WP", style=label.style_label_up, color=bullColor, textcolor=color.white, size=size.small, tooltip=bullTip)
if bearSignal
    label.new(bar_index, high, "WP", style=label.style_label_down, color=bearColor, textcolor=color.white, size=size.small, tooltip=bearTip)

// --- Sub-signals (optional) ---
plotshape(showAllSignals and bearTrap and not bullSignal, title="Bear Trap", style=shape.triangleup, location=location.belowbar, color=color.new(bullColor, 40), size=size.tiny)
plotshape(showAllSignals and bullTrap and not bearSignal, title="Bull Trap", style=shape.triangledown, location=location.abovebar, color=color.new(bearColor, 40), size=size.tiny)
plotshape(showAllSignals and bullExhaustion, title="Bull Exhaustion", style=shape.xcross, location=location.abovebar, color=color.new(bearColor, 50), size=size.tiny)
plotshape(showAllSignals and bearExhaustion, title="Bear Exhaustion", style=shape.xcross, location=location.belowbar, color=color.new(bullColor, 50), size=size.tiny)
plotshape(showAllSignals and bullWickDiv, title="Bull Wick Divergence", style=shape.diamond, location=location.belowbar, color=color.new(bullColor, 50), size=size.tiny)
plotshape(showAllSignals and bearWickDiv, title="Bear Wick Divergence", style=shape.diamond, location=location.abovebar, color=color.new(bearColor, 50), size=size.tiny)

// --- Wick Pressure Background (visible tint) ---
bgcolor(strongBullPressure ? color.new(bullColor, 85) : strongBearPressure ? color.new(bearColor, 85) : na, title="Wick Pressure Background")

// --- Bar coloring based on Wick DNA (always visible) ---
color dnaBarColor = bullSignal ? bullColor : bearSignal ? bearColor : wickDNA == "BullReject" ? color.new(bullColor, 30) : wickDNA == "BearReject" ? color.new(bearColor, 30) : wickDNA == "Contested" ? color.new(color.orange, 40) : na
barcolor(dnaBarColor, title="Wick DNA Bar Color")

// ============================================================================
// 11. DASHBOARD
// ============================================================================

// Table MUST be declared at global scope with var (not inside if block)
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(#1a1a2e, 10), frame_color=color.new(#e0e0e0, 70), frame_width=1, border_color=color.new(#e0e0e0, 80), border_width=1)

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "WickPulse", text_color=color.new(#FFFFFF, 0), text_size=size.normal, bgcolor=color.new(#0f3460, 10), text_halign=text.align_left)
    table.cell(dash, 1, 0, "Engine", text_color=color.new(#FFFFFF, 0), text_size=size.normal, bgcolor=color.new(#0f3460, 10), text_halign=text.align_right)

    // Wick DNA
    color dnaColor = wickDNA == "BullReject" ? bullColor : wickDNA == "BearReject" ? bearColor : wickDNA == "Contested" ? color.orange : wickDNA == "Conviction" ? color.white : color.gray
    table.cell(dash, 0, 1, "Wick DNA", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, wickDNA, text_color=dnaColor, text_size=size.small, text_halign=text.align_right)

    // WPI
    string wpiStr = str.tostring(wickPressureIndex, "#.##")
    color wpiColor = wickPressureIndex > pressureThresh ? bullColor : wickPressureIndex < -pressureThresh ? bearColor : color.gray
    table.cell(dash, 0, 2, "Wick Pressure", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, wpiStr, text_color=wpiColor, text_size=size.small, text_halign=text.align_right)

    // Trap
    string trapStr = bearTrap ? "Bear Trap!" : bullTrap ? "Bull Trap!" : "None"
    color trapColor = bearTrap ? bullColor : bullTrap ? bearColor : color.gray
    table.cell(dash, 0, 3, "Trap", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, trapStr, text_color=trapColor, text_size=size.small, text_halign=text.align_right)

    // Exhaustion
    string exhStr = bullExhaustion ? "Bulls Fading" : bearExhaustion ? "Bears Fading" : "None"
    color exhColor = bullExhaustion ? bearColor : bearExhaustion ? bullColor : color.gray
    table.cell(dash, 0, 4, "Exhaustion", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, exhStr, text_color=exhColor, text_size=size.small, text_halign=text.align_right)

    // Tension
    string tensStr = tensionBuilding ? str.tostring(tensionScore, "#") + "%" : "None"
    color tensClr = tensionBuilding ? color.yellow : color.gray
    table.cell(dash, 0, 5, "Tension", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, tensStr, text_color=tensClr, text_size=size.small, text_halign=text.align_right)

    // Divergence
    string divStr = bullWickDiv ? "Bullish" : bearWickDiv ? "Bearish" : "None"
    color divClr = bullWickDiv ? bullColor : bearWickDiv ? bearColor : color.gray
    table.cell(dash, 0, 6, "Wick Divergence", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 6, divStr, text_color=divClr, text_size=size.small, text_halign=text.align_right)

    // Confluence Score
    string confStr = "Bull: " + str.tostring(bullScore) + " | Bear: " + str.tostring(bearScore)
    color confClr = bullScore > bearScore and bullScore >= minConfluence ? bullColor : bearScore > bullScore and bearScore >= minConfluence ? bearColor : color.gray
    table.cell(dash, 0, 7, "Confluence", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 7, confStr, text_color=confClr, text_size=size.small, text_halign=text.align_right)

    // Phantom Levels count
    string phantomStr = "S: " + str.tostring(array.size(phantomBullLevels)) + " | R: " + str.tostring(array.size(phantomBearLevels))
    table.cell(dash, 0, 8, "Phantom Levels", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 8, phantomStr, text_color=color.white, text_size=size.small, text_halign=text.align_right)

if not showDashboard
    table.clear(dash, 0, 0, 1, 8)

// ============================================================================
// 12. ALERTS
// ============================================================================

alertcondition(bullSignal, title="WickPulse Long", message="WickPulse: LONG signal detected — Confluence {{plot(\"bullScore\")}}")
alertcondition(bearSignal, title="WickPulse Short", message="WickPulse: SHORT signal detected — Confluence {{plot(\"bearScore\")}}")
alertcondition(bearTrap, title="Bear Trap", message="WickPulse: Bear Trap detected — potential long")
alertcondition(bullTrap, title="Bull Trap", message="WickPulse: Bull Trap detected — potential short")
alertcondition(tensionBuilding, title="Wick Tension", message="WickPulse: Tension zone forming — breakout imminent")
alertcondition(bullExhaustion or bearExhaustion, title="Exhaustion", message="WickPulse: Exhaustion signature detected")

// Plot scores for alert messages
plot(bullScore, title="bullScore", display=display.none)
plot(bearScore, title="bearScore", display=display.none)
plot(wickPressureIndex, title="WPI", display=display.none)
plot(trapIntensity, title="trapIntensity", display=display.none)
plot(tensionScore, title="tensionScore", display=display.none)
